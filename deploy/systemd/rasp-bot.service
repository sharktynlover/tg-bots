[Unit]
Description=College schedule bot gateway
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/rasp
ExecStart=/root/.bun/bin/bun run apps/bot-gateway/src/main.ts
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

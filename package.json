{
	"name": "college-bot",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --watch apps/bot-gateway/src/main.ts",
		"start": "bun run apps/bot-gateway/src/main.ts",
		"dev:cron": "bun run --watch apps/schedule-service/src/main.ts",
		"start:cron": "bun run apps/schedule-service/src/main.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run packages/shared/src/db/migrate.ts",
		"lint": "eslint .",
		"format": "prettier -w .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"amqplib": "^0.10.5",
		"dotenv": "^16.4.7",
		"drizzle-orm": "^0.38.4",
		"grammy": "^1.33.0",
		"ical-generator": "^8.0.1",
		"ioredis": "^5.4.2",
		"node-cron": "^3.0.3",
		"postgres": "^3.4.5",
		"reflect-metadata": "^0.2.2",
		"tsyringe": "^4.8.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.18.0",
		"@types/amqplib": "^0.10.6",
		"@types/node": "^22.10.7",
		"@types/node-cron": "^3.0.11",
		"drizzle-kit": "^0.30.2",
		"eslint": "^9.18.0",
		"globals": "^15.14.0",
		"prettier": "^3.4.2",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.21.0"
	}
}

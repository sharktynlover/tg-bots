[Unit]
Description=College dating Telegram bot
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/date
Environment=SERVICE_NAME=bot-service
Environment=LOG_FILE_PATH=/root/date/logs/bot.log
ExecStart=/root/.bun/bin/bun run src/main.ts
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

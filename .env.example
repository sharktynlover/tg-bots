# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Через запятую: id администраторов для /admin, /stats, /broadcast и фидбека
ADMIN_IDS=

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/college

# Redis — состояния диалогов (без него используется память процесса)
REDIS_URL=redis://localhost:6379

# RabbitMQ — события между bot-gateway и schedule-service
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# API колледжа
COLLEGE_API_URL=https://akademiks.urtt.ru

# Cron (часовой пояс Asia/Yekaterinburg)
SCHEDULE_CRON=*/5 * * * *
PRESCHEDULE_CRON=*/20 * * * 5
REMINDER_CRON=* * * * *

TZ=Asia/Yekaterinburg
LOG_LEVEL=info

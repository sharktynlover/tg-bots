# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
# Leave TELEGRAM_WEBHOOK_URL empty to run the bot in long-polling mode
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=random_secret

# Database
DATABASE_URL=postgresql://user:pass@postgres:5432/dating_db
DATABASE_POOL_SIZE=20

# Redis
REDIS_URL=redis://redis:6379

# Roles (comma separated Telegram IDs)
DEVELOPER_TELEGRAM_ID=123456789
ADMIN_TELEGRAM_IDS=

# Limits (can be overridden at runtime via /config)
SUPERLIKES_PER_WEEK=1
MAX_PHOTOS=3
MAX_AGE=25
MIN_AGE=15
MAX_DESCRIPTION_LENGTH=150
SPAM_LIKE_THRESHOLD=1.0
SPAM_LIKE_MIN_ACTIONS=30
SPAM_LIKE_COOLDOWN_SECONDS=7200

# Server
PORT=3000

# Logs
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/bot.log
